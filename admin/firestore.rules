rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function hasActiveAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.status == 'active';
    }

    function hasCompletedAccount() {
      return hasActiveAccount()
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('mustChangePassword', false) != true;
    }

    function canCreateLoanNotification(accountId, notificationId) {
      let data = request.resource.data;
      let loanPath = /databases/$(database)/documents/loans/$(data.loanId);
      let loan = get(loanPath).data;
      return hasCompletedAccount()
        && request.auth.uid == accountId
        && data.keys().hasOnly([
          'id', 'loanId', 'type', 'title', 'message', 'isRead', 'timestamp'
        ])
        && data.id == notificationId
        && data.loanId is string
        && data.type is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 300
        && data.isRead == false
        && data.timestamp == request.time
        && exists(loanPath)
        && loan.borrowerUid == request.auth.uid
        && (
          (data.type in ['approved', 'rejected']
            && loan.status == data.type
            && notificationId == data.loanId + '_' + data.type)
          || (data.type == 'returned'
            && loan.status == 'returned'
            && notificationId == data.loanId + '_returned')
          || (data.type == 'due_reminder'
            && loan.status == 'approved'
            && notificationId.matches(
              '^' + data.loanId + '_due_[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            ))
          || (data.type == 'overdue'
            && loan.status == 'approved'
            && loan.end is string
            && notificationId.matches(
              '^' + data.loanId + '_overdue_[0-9]{4}-[0-9]{2}-[0-9]{2}$'
            ))
        );
    }

    match /equipment/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /loans/{loanId} {
      allow read: if isAdmin() || hasCompletedAccount();
      allow create: if isAdmin()
        || (hasCompletedAccount()
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'id', 'borrowerUid', 'equipmentId', 'name', 'borrower', 'start', 'end',
            'status', 'returnedOn', 'updatedAt'
          ])
          && request.resource.data.id == loanId
          && request.resource.data.borrowerUid == request.auth.uid
          && request.resource.data.equipmentId is string
          && request.resource.data.name is string
          && request.resource.data.borrower is string
          && request.resource.data.start is string
          && request.resource.data.end is string
          && request.resource.data.returnedOn == null
          && request.resource.data.updatedAt is int);
      allow update: if isAdmin()
        || (hasCompletedAccount()
          && resource.data.borrowerUid == request.auth.uid
          && (
            (resource.data.status == 'pending'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'updatedAt'
              ])
              && request.resource.data.updatedAt is int)
            || (resource.data.status == 'approved'
              && request.resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'checkedOutAt', 'updatedAt'
              ])
              && request.resource.data.checkedOutAt is int
              && request.resource.data.updatedAt is int)
            || (resource.data.status == 'approved'
              && resource.data.checkedOutAt is int
              && resource.data.get('returnVerificationStatus', '') in ['', 'rejected']
              && request.resource.data.status == 'return_pending'
              && request.resource.data.returnRequestedAt == request.time
              && request.resource.data.returnVerificationStatus == 'pending'
              && request.resource.data.returnRejectionReason == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'returnRequestedAt', 'returnVerificationStatus',
                'returnRejectionReason', 'updatedAt'
              ])
              && request.resource.data.updatedAt is int)
          ));
      allow delete: if isAdmin();
    }
    match /meta/{docId} {
      allow read, write: if isAdmin();

      match /adminNotifications/{notificationId} {
        allow get, list: if isAdmin() && request.auth.uid == docId;
        allow create: if isAdmin()
          && request.auth.uid == docId
          && request.resource.data.keys().hasOnly(['read', 'receivedAt'])
          && request.resource.data.read == false
          && request.resource.data.receivedAt == request.time;
        allow update: if isAdmin()
          && request.auth.uid == docId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if false;
      }

      match /chatReads/{userId} {
        allow get, list: if isAdmin() && request.auth.uid == docId;
        allow create, update: if isAdmin()
          && request.auth.uid == docId
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if isAdmin() && request.auth.uid == docId;
      }
    }
    match /accountRequests/{requestId} {
      allow create: if isAdmin();
      allow read: if isAdmin()
        || (signedIn() && resource.data.authUid == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.authUid == request.auth.uid
          && resource.data.status == 'approved'
          && resource.data.keys().hasAny(['temporaryPassword'])
          && !request.resource.data.keys().hasAny(['temporaryPassword'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'temporaryPassword'
          ]));
      allow delete: if isAdmin();

      match /privateCredentials/{credentialId} {
        function parentRequest() {
          return get(/databases/$(database)/documents/accountRequests/$(requestId)).data;
        }

        function requesterAccount() {
          return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
        }

        allow read: if signedIn()
          && credentialId == 'temporary'
          && !isAdmin()
          && parentRequest().authUid == request.auth.uid
          && parentRequest().status == 'approved'
          && requesterAccount().status == 'active'
          && requesterAccount().mustChangePassword == true;
        allow delete: if isAdmin()
          || (signedIn()
            && credentialId == 'temporary'
            && parentRequest().authUid == request.auth.uid
            && requesterAccount().status == 'active'
            && requesterAccount().mustChangePassword == false);
      }
    }
    match /accounts/{accountId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == accountId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (hasActiveAccount()
          && request.auth.uid == accountId
          && request.resource.data.email == request.auth.token.email
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'email', 'gender', 'college', 'course', 'yearLevel',
              'block', 'profileImage', 'profileUpdatedAt'
            ])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['profileImage'])
              || (request.resource.data.profileImage is string
                && request.resource.data.profileImage.size() <= 700000))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'mustChangePassword'
            ])
              && resource.data.mustChangePassword == true
              && request.resource.data.mustChangePassword == false)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'notificationPreferences'
            ])
              && request.resource.data.notificationPreferences is map
              && request.resource.data.notificationPreferences.keys().hasOnly([
                'requestUpdatesEnabled',
                'returnRemindersEnabled',
                'pushNotificationsEnabled'
              ])
              && request.resource.data.notificationPreferences.requestUpdatesEnabled is bool
              && request.resource.data.notificationPreferences.returnRemindersEnabled is bool
              && request.resource.data.notificationPreferences.pushNotificationsEnabled is bool)
          ));

      match /devices/{deviceId} {
        allow read: if isAdmin()
          || (hasActiveAccount() && request.auth.uid == accountId);
        allow create, update: if hasCompletedAccount()
          && request.auth.uid == accountId
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.updatedAt is int;
        allow delete: if isAdmin()
          || (hasActiveAccount() && request.auth.uid == accountId);
      }

      match /notifications/{notificationId} {
        allow read: if isAdmin()
          || (hasActiveAccount() && request.auth.uid == accountId);
        allow create: if isAdmin()
          || canCreateLoanNotification(accountId, notificationId);
        allow delete: if isAdmin();
        allow update: if isAdmin()
          || (hasActiveAccount()
            && request.auth.uid == accountId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isRead'])
            && request.resource.data.isRead is bool);
      }
    }
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }
    match /publicProfiles/{profileId} {
      allow get: if profileId == 'admin' && (isAdmin() || hasCompletedAccount());
      allow list: if false;
      allow create, update: if profileId == 'admin'
        && isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'photo'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && (request.resource.data.photo == null
          || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 700000));
      allow delete: if isAdmin();
    }
    match /chats/{userId} {
      function canAccessChat() {
        return isAdmin()
          || (hasCompletedAccount() && request.auth.uid == userId);
      }

      function validChatUpdate(senderRole) {
        return request.resource.data.keys().hasOnly([
            'userId', 'userName', 'userEmail', 'lastMessage',
            'lastMessageAt', 'lastSenderId', 'lastSenderRole'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 600
          && request.resource.data.userEmail is string
          && request.resource.data.userEmail.size() <= 254
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() > 0
          && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.lastSenderId == request.auth.uid
          && request.resource.data.lastSenderRole == senderRole;
      }

      allow get: if isAdmin()
        || (hasCompletedAccount() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update: if (
          isAdmin()
          && validChatUpdate('admin')
        ) || (
          hasCompletedAccount()
          && request.auth.uid == userId
          && validChatUpdate('user')
        );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function validMessage(senderRole) {
          return request.resource.data.keys().hasOnly([
              'senderId', 'senderName', 'senderRole', 'senderPhoto',
              'text', 'createdAt'
            ])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderName is string
            && request.resource.data.senderName.size() <= 600
            && request.resource.data.senderRole == senderRole
            && (!('senderPhoto' in request.resource.data)
              || (senderRole == 'admin'
                && (request.resource.data.senderPhoto == null
                  || (request.resource.data.senderPhoto is string
                    && request.resource.data.senderPhoto.size() <= 700000))))
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.createdAt == request.time;
        }

        allow get, list: if canAccessChat();
        allow create: if existsAfter(
            /databases/$(database)/documents/chats/$(userId)
          ) && (
            (isAdmin() && validMessage('admin'))
            || (hasCompletedAccount()
              && request.auth.uid == userId
              && validMessage('user'))
          );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
